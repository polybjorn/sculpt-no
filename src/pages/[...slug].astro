---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { allRoutes } from '../i18n/routes.js';

// Every page in every language comes from here. Adding a page means one entry
// in src/i18n/pages.js and one content file per language.
export async function getStaticPaths() {
  return allRoutes().map((route) => ({
    params: { slug: route.slug || undefined },
    props: route,
  }));
}

const { key, locale } = Astro.props;

const entry = await getEntry('pages', `${locale}/${key}`);
if (!entry) throw new Error(`no content entry for ${locale}/${key}`);
const { title, description } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={description} lang={locale} page={key}>
  <div class="page">
    <Content />
  </div>
</Layout>
