---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  page?: string;
}

import '../styles/global.css';
import { localeInfo, defaultLocale } from '../i18n/locales.js';
import { Image, getImage } from 'astro:assets';
import { pathFor, resolveRoute, localesWithPage } from '../i18n/routes.js';
import { pages, menu, contact, social, sourceUrl, siteName, titleSuffix, business } from '../i18n/pages.js';
import { ui } from '../i18n/ui.js';
import SocialLinks from '../components/SocialLinks.astro';
import logo from '../assets/images/logo.webp';
import shareSource from '../assets/images/home-01.webp';
import noScriptCss from '../styles/no-script.css?url';
import displayFont from '../assets/fonts/cormorant-garamond-latin-400-normal.woff2?url';
import titleFont from '../assets/fonts/cormorant-garamond-latin-700-normal.woff2?url';
import bodyFont from '../assets/fonts/dm-sans-latin-300-normal.woff2?url';

const { title, description, lang = defaultLocale, page = 'home' } = Astro.props;
const t = ui(lang);
const info = localeInfo(lang);
const currentPath = Astro.url.pathname;
const site = (Astro.site?.href ?? 'https://sculpt.no/').replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Keep preview deployments out of search indexes; disappears automatically
// once `site` is sculpt.no again.
const isPreview = !site.includes('sculpt.no');
const canonical = `${site}${currentPath}`;
// The 404 page answers at any missing address, so it has no address of its
// own to name as canonical or offer in another language.
const listed = pages.some((p) => p.key === page);

// The faces the first screen is set in, fetched beside the stylesheet rather
// than after it: found only through it, they arrived after the first paint,
// and the heading rewrapping as they swapped in shifted the page (#46).
const preloadFonts = [page === 'home' ? titleFont : displayFont, bodyFont];

// sculpt.no shared its logo as the link preview; the sculptures say more about
// what she makes. 1200x630 is the shape Facebook and Messenger crop a preview to.
const share = await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareAlt = 'Fire gravidskulpturer fra Sculpt side om side, i beige, svart, hvit og gullfarget utførelse.';

// Google takes the business card in search results from this. A JSON block is
// data the browser never runs, so `script-src 'self'` does not refuse it.
const structured = page === 'home' && JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    // "Sculpt" alone is a common word; the alternates tell Google which site
    // name to show over its result.
    { '@type': 'WebSite', name: siteName, alternateName: ['Sculpt Svindland', 'sculpt.no'], url: `${site}${base}/` },
    {
      '@type': 'Organization',
      name: siteName,
      legalName: business.legalName,
      address: { '@type': 'PostalAddress', addressLocality: business.locality, addressCountry: 'NO' },
      url: `${site}${base}/`,
      logo: `${site}${(await getImage({ src: logo })).src}`,
      email: contact.email,
      telephone: contact.phone.href.replace('tel:', ''),
      sameAs: social.map((s) => s.url),
    },
  ],
});

// Nav links point at the reader's language, or at the nearest translated
// language while a translation is still missing.
const link = (key: string, label: string) => {
  const route = resolveRoute(key, lang);
  return { ...route, label, current: currentPath === route.href };
};
const nav = menu.map((item) => typeof item === 'string'
  ? link(item, t.nav[item])
  : { group: item.group, label: t.menu[item.group], items: item.pages.map((key) => link(key, t.nav[key])) });


const homeHref = resolveRoute('home', lang).href;
const pageLocales = localesWithPage(page);
---

<!DOCTYPE html>
<html lang={lang} dir={info.dir}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{`${title}${titleSuffix}`}</title>
  {description && <meta name="description" content={description}>}
  {listed && <link rel="canonical" href={canonical}>}
  {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin>)}
  <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48">
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}>
  <noscript><link rel="stylesheet" href={noScriptCss}></noscript>
  {!isPreview && <link rel="sitemap" href={`${base}/sitemap-index.xml`}>}
  {isPreview && <meta name="robots" content="noindex">}
  {listed && pageLocales.map((l) => (
    <link rel="alternate" hreflang={l} href={`${site}${pathFor(page, l)}`} />
  ))}
  {listed && <link rel="alternate" hreflang="x-default" href={`${site}${pathFor(page, defaultLocale)}`} />}
  <meta property="og:site_name" content={siteName}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={`${title}${titleSuffix}`}>
  {description && <meta property="og:description" content={description}>}
  {listed && <meta property="og:url" content={canonical}>}
  <meta property="og:locale" content={info.og}>
  <meta property="og:image" content={`${site}${share.src}`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={shareAlt}>
  <meta name="twitter:card" content="summary_large_image">
  {structured && <script type="application/ld+json" set:html={structured} />}
  {/* connect-src: Lighthouse and PageSpeed Insights read robots.txt from
      inside the page, and with no connect-src the request is refused and the
      file is scored invalid. */}
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'">
  <meta name="referrer" content="no-referrer">
</head>
<body
  data-carousel-prev={t.chrome.carouselPrev} data-carousel-next={t.chrome.carouselNext}
  data-photo-open={t.chrome.photoOpen} data-photo-close={t.chrome.photoClose}
  data-photo-prev={t.chrome.photoPrev} data-photo-next={t.chrome.photoNext} data-photo-count={t.chrome.photoCount}
>
  <a href="#main" class="skip-link">{t.chrome.skipLink}</a>
  <header class="site-header">
    <nav class="nav">
      <a href={homeHref} class="nav-home" aria-label={t.chrome.homeLabel}>
        <Image src={logo} alt="" width={48} densities={[1, 2]} loading="eager" />
        <span>Sculpt</span>
      </a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="nav-links">{t.menu.toggle}</button>
      <ul class="nav-links" id="nav-links">
        {nav.map((item) => (
          <li>
            {'items' in item ? (
              <details class:list={['menu-group', { current: item.items.some((i) => i.current) }]}>
                <summary>{item.label}</summary>
                <ul>
                  {item.items.map(({ href, label, lang: linkLang, current }) => (
                    <li><a href={href} hreflang={linkLang === lang ? undefined : linkLang} aria-current={current ? 'page' : undefined}>{label}</a></li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} hreflang={item.lang === lang ? undefined : item.lang} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      <SocialLinks labels={t.social} />
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <p class="footer-contact">
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={contact.phone.href}>{contact.phone.label}</a>
    </p>
    <div class="footer-links">
      <SocialLinks labels={t.social} label={t.footer.social} />
      <p class="footer-source"><a href={sourceUrl}>{t.footer.source}</a></p>
    </div>
    <p class="footer-business">{t.footer.business}</p>
  </footer>

  <script src="../scripts/nav.js"></script>
  <script src="../scripts/carousel.js"></script>
  <script src="../scripts/gallery.js"></script>
</body>
</html>
