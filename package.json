{
  "name": "sculpt-no",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:build": "node scripts/build-preview.mjs",
    "astro": "astro",
    "clean": "rm -rf node_modules/.astro dist",
    "pins:check": "node scripts/node-pins-check.mjs",
    "text-changes:check": "node scripts/text-changes-check.mjs",
    "pretest": "astro build --force",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "astro check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
